{
    "name": "@reillymc/es-utils",
    "version": "0.0.14",
    "description": "A small collection of common utilities used across TypeScript projects.",
    "type": "module",
    "sideEffects": false,
    "exports": "./lib/index.js",
    "types": "./lib/default.d.ts",
    "scripts": {
        "clean": "rm -rf ./lib",
        "build": "npm run clean && tsc -p ./tsconfig.build.json",
        "test": "node --test src/**.test.ts",
        "prepack": "npm run build"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/reillymc/es-utils.git"
    },
    "keywords": [
        "npm",
        "javascript",
        "typescript"
    ],
    "author": "Reilly MacKenzie-Cree",
    "license": "MIT",
    "bugs": {
        "url": "https://github.com/reillymc/es-utils/issues"
    },
    "homepage": "https://github.com/reillymc/es-utils#readme",
    "devDependencies": {
        "@types/node": "^24.13.3",
        "typescript": "^5.8"
    }
}
